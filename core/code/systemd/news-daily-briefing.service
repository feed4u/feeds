# User service for the host-built daily topics (all verticals) and briefings (k5, 4u).
# Install (once, on the host that runs the local LLM lanes):
#   cp core/code/systemd/news-daily-briefing.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now news-daily-briefing.timer
# Edit the ExecStart path if the repository lives elsewhere.
[Unit]
Description=News: daily LLM topics and briefings from the local lane
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /mnt/data1/projects/news/core/code/run_daily_briefings.sh
# Topics for a ~2000-story Finnish day take about an hour on a busy lane; the
# whole run must still finish before the 08:23 UTC data build publishes it.
TimeoutStartSec=5h
Nice=10
