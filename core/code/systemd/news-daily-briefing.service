# User service for the host-built daily briefings (k5, 4u).
# Install (once, on the host that runs the local LLM lanes):
#   cp core/code/systemd/news-daily-briefing.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now news-daily-briefing.timer
# Edit the ExecStart path if the repository lives elsewhere.
[Unit]
Description=News: daily LLM briefings (k5, 4u) from the local lane
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /mnt/data1/projects/news/core/code/run_daily_briefings.sh
TimeoutStartSec=3h
Nice=10
