# syntax=docker/dockerfile:1.6

##
# Data pipeline image
##
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY code/base/requirements.txt /app/code/base/requirements.txt
RUN pip install --no-cache-dir -r /app/code/base/requirements.txt

COPY code/base/ /app/code/base/
COPY code/k5/ /app/code/k5/
COPY source/ /app/source/

VOLUME ["/app/data"]
ENV DAYS_BACK=30 MAX_WORKERS=10 REQUEST_TIMEOUT=25

# Standalone runs fetch k5 news; Compose runs the four-stage data service.
CMD ["python", "/app/code/base/fetch_news.py", "--base-dir", "/app", "--vertical", "k5"]
