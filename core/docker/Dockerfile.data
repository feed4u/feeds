# syntax=docker/dockerfile:1.6

##
# Data pipeline image
##
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements.txt /app/scripts/requirements.txt
RUN pip install --no-cache-dir -r /app/scripts/requirements.txt

COPY scripts/ /app/scripts/
COPY source/ /app/source/

VOLUME ["/app/data"]
ENV DAYS_BACK=30 MAX_WORKERS=10 REQUEST_TIMEOUT=25

# Default command fetches news, archives, trends sequentially
CMD ["python", "/app/scripts/fetch_news.py"]
